# Database Configuration
MONGODB_URI=mongodb://localhost:27017/project_submission

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Server Configuration
PORT=5000

# Supabase Configuration (for file uploads)
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual configuration
# 3. Make sure MongoDB is running locally or update MONGODB_URI
# 4. Create a Supabase project and get your URL and key
# 5. The server will automatically create the 'uploads' bucket if it doesn't exist 