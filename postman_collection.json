{
  "info": {
    "name": "Project Submission & Evaluation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"learner\"\n}"},
            "url": {"raw": "http://localhost:5000/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "register"]}
          }
        },
        {
          "name": "Login as Learner",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"learner1@gmail.com\",\n  \"password\": \"12345678\"\n}"},
            "url": {"raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Login as Instructor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"instructor1@gmail.com\",\n  \"password\": \"12345678\"\n}"},
            "url": {"raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "http://localhost:5000/api/course", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "course"]}
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "http://localhost:5000/api/course/{{courseId}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "course", "{{courseId}}"]}
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Submit Project (Learner)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "courseId", "value": "{{courseId}}", "type": "text"},
                {"key": "githubLink", "value": "https://github.com/example/repo", "type": "text"},
                {"key": "file", "type": "file"}
              ]
            },
            "url": {"raw": "http://localhost:5000/api/project/submit", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "project", "submit"]}
          }
        },
        {
          "name": "Get Submissions by Course (Instructor)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "http://localhost:5000/api/project/{{courseId}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "project", "{{courseId}}"]}
          }
        },
        {
          "name": "Evaluate Submission (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"submissionId\": \"{{submissionId}}\",\n  \"rating\": 8,\n  \"tags\": [\"React\", \"API\", \"JavaScript\"],\n  \"comment\": \"Excellent work! Great implementation of the concepts.\"\n}"},
            "url": {"raw": "http://localhost:5000/api/project/evaluate", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "project", "evaluate"]}
          }
        },
        {
          "name": "Get My Evaluations (Learner)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "http://localhost:5000/api/project/evaluation/{{userId}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "project", "evaluation", "{{userId}}"]}
          }
        }
      ]
    },
    {
      "name": "Instructor",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "http://localhost:5000/api/project/dashboard", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "project", "dashboard"]}
          }
        },
        {
          "name": "Get Submissions (Filtered, Sorted)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "http://localhost:5000/api/project/submissions?courseId={{courseId}}&status={{status}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "project", "submissions"],
              "query": [
                {"key": "courseId", "value": "{{courseId}}"},
                {"key": "status", "value": "{{status}}"}
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "token", "value": "your_jwt_token_here" },
    { "key": "courseId", "value": "course_id_here" },
    { "key": "status", "value": "pending" }
  ]
} 